generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ObjectType {
  RENT
  SALE
}

enum ObjectCategory {
  OFFICE
  RETAIL
  WAREHOUSE
  FREE_PURPOSE
  PRODUCTION
  LAND
  READY_BUSINESS
}

enum ObjectStatus {
  ACTIVE
  ARCHIVED
}

enum LeadStatus {
  NEW
  IN_WORK
  DONE
  REJECTED
}

model Object {
  id           String         @id @default(uuid())
  type         ObjectType
  category     ObjectCategory
  title        String
  description  String
  address      String
  metro        String?
  areaTotal    Float
  areaMin      Float?
  floor        Int?
  floorsTotal  Int?
  price        Float
  pricePerSqm  Float?
  photos          String[]
  lat             Float?
  lng             Float?
  landCategory    String?
  landVri         String?
  cadastralNumber String?
  status       ObjectStatus   @default(ACTIVE)
  featured     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // DD COMPS import (Cosmo Capital CRM import, июнь 2026)
  ddCompsId    String?        @unique
  blocksCount  Int?
  trustScore   Float?
  trustClass   String?
  dataSource   String?
  recordedDate DateTime?
  manager      String?
  stage        String?

  leads        Lead[]
  deals        Deal[]

  @@map("objects")
}

model Lead {
  id        String     @id @default(uuid())
  name      String
  phone     String
  email     String?
  message   String?
  objectId  String?
  object    Object?    @relation(fields: [objectId], references: [id], onDelete: SetNull)
  source    String     @default("site")
  status    LeadStatus @default(NEW)
  notes     String?
  createdAt DateTime   @default(now())

  @@map("leads")
}

model Service {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String?
  order       Int      @default(0)
  active      Boolean  @default(true)

  @@map("services")
}

// ─── Users / Roles ──────────────────────────────────────────────────────────

enum UserRole {
  HEAD
  SENIOR_BROKER
  BROKER
  RESEARCH
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  name       String
  role       UserRole @default(BROKER)
  brokerName String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("users")
}

// ─── CRM Pipeline ───────────────────────────────────────────────────────────

enum DealSegment {
  BIG_BOX
  LIGHT_INDUSTRIAL
  LAND
}

enum DealType {
  LI_RENT
  LI_SALE_LAND
  BB_RENT
  BB_SALE_LAND
  BTS_SLB_MANDATE
}

enum LossReason {
  CHOSE_ANOTHER_WITHOUT_US
  WENT_TO_COMPETITOR
  POSTPONED_DECISION
  BUDGET_NOT_CONFIRMED
  OWNER_REMOVED_OBJECT
  OTHER
}

enum ActivityType {
  CALL
  MEETING
  VIEWING
  PROPOSAL_SENT
  EMAIL
  OTHER
}

model Deal {
  id                 String      @id @default(uuid())
  brokerName         String
  segment            DealSegment
  dealType           DealType
  clientName         String
  objectDescription  String
  areaSqm            Float?
  stage              Int         @default(1)
  expectedGci        Float
  expectedCloseDate  DateTime?
  lastStageChangedAt DateTime    @default(now())
  isLost             Boolean     @default(false)
  isClosed           Boolean     @default(false)
  actualGci          Float?
  lossReason         LossReason?
  lossComment        String?
  lprContact         String?
  leadSource         String?
  nextActionDate     DateTime?
  nextActionDesc     String?
  notes                String?
  qualificationData    Json?
  reEngagementDate     DateTime?
  objectId             String?
  linkedObject         Object?     @relation(fields: [objectId], references: [id], onDelete: SetNull)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  stageChanges StageChange[]
  activities   DealActivity[]

  @@map("deals")
}

model StageChange {
  id        String   @id @default(uuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage Int
  toStage   Int
  comment   String?
  changedBy String?
  changedAt DateTime @default(now())

  @@map("deal_stage_changes")
}

model DealActivity {
  id           String       @id @default(uuid())
  dealId       String
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type         ActivityType
  description  String
  activityDate DateTime     @default(now())
  createdBy    String?
  createdAt    DateTime     @default(now())

  @@map("deal_activities")
}
